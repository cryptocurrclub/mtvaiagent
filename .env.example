# Copy this file to .env and adjust as needed. All values are optional;
# sensible defaults live in config.py.

MTV_RPC_URL=https://rpc.mtv.ac
MTV_CHAIN_ID=62621
MTV_WALLET_ADDRESS=0xecff9107e7193ac490a4694b2db27c849a62446a
MTV_NATIVE_DECIMALS=18
MTV_NATIVE_SYMBOL=MTV

# MultiVAC's native staking has no smart contract; these hit the explorer's
# own backend API instead (undocumented, reverse-engineered - see config.py).
MTV_STAKING_API_BASE_URL=https://e.mtv.ac
MTV_STAKING_APR_NUMERATOR=6570000000

MTV_COINGECKO_ID=multivac
MTV_CRYPTOCOMPARE_SYMBOL=MTV
MTV_VS_CURRENCY=usd
MTV_DEFAULT_PERIOD=30D

MTV_REQUEST_TIMEOUT=10
MTV_MAX_RETRIES=4
MTV_RETRY_BACKOFF_BASE=0.5

MTV_PRICE_CACHE_TTL=60
MTV_HISTORY_CACHE_TTL=300
MTV_BALANCE_CACHE_TTL=30

MTV_LOG_LEVEL=INFO
