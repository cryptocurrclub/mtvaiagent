# Optional values
MAX_FUNDING_PER_REQUEST=1000
REQUIRED_APPROVALS=1
CROSS_SHARD_MESSENGER_ADDRESS=0x0000000000000000000000000000000000000000
MULTIVAC_DEX_ROUTER_ADDRESS=0x0000000000000000000000000000000000000000
